# 이 파일을 .env.local로 복사하고 값을 직접 넣는다. .env.local은 저장소에 올리지 않는다.
# 값은 채팅·문서·코드에 쓰지 않는다.

# Supabase 프로젝트 주소와 공개 키(Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용. 브라우저 코드에서 쓰지 않는다(정기 수집 등 서버 일에만, 판단 저장에는 쓰지 않음)
SUPABASE_SERVICE_ROLE_KEY=

# 개발·QA 환경에서만 true. 운영 배포(VERCEL_ENV=production)에서는 true여도 꺼진다
NEXT_PUBLIC_ENABLE_TEST_LOGIN=false

# 정기 실행 주소(/api/cron/daily)를 지키는 값. 서버에만 둔다. Vercel이 정기 실행을 부를 때 같은 값을 보낸다
CRON_SECRET=

# GitHub 저장소 정보 수집(fetch_github)용 서버 토큰. 서버에만 둔다. 없으면 호출하지 않고 수집 오류로 남는다(공백·줄바꿈·따옴표 없이 값만)
GITHUB_TOKEN=

# Claude(대응안 초안) 호출 키. 서버에만 둔다. 없으면 초안을 만들지 않고 알림은 그대로 만든다(summarize 단계에 not_configured가 남는다)
ANTHROPIC_API_KEY=
# 선택: 모델 이름(기본 claude-sonnet-5-5). 비용·품질은 황재웅이 정한다
ANTHROPIC_MODEL=

# 관리자 실패 시연(/admin/demo)을 켜는 스위치. 값이 정확히 true일 때만, 그리고 미리보기·로컬에서만 켜진다(운영 VERCEL_ENV=production에서는 켜도 꺼진 채)
ENABLE_FAIL_DEMO=
